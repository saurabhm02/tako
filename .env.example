# LLM command-bar interpretation — dev/test only.
# Not read anywhere unless you export these into the process environment
# yourself. A future Settings screen will replace this with securely stored
# per-user keys/models; nothing in src/main/llm/* other than config.ts needs to change.
#
# provider = openai | anthropic | gemini | custom
TAKO_LLM_PROVIDER=
TAKO_LLM_API_KEY=
TAKO_LLM_MODEL=
# only required when TAKO_LLM_PROVIDER=custom (OpenRouter, Ollama, or any
# other OpenAI-compatible endpoint)
TAKO_LLM_BASE_URL=

# Speech-to-Text (Voice commands) — optional dev/test config
# provider = deepgram
TAKO_STT_PROVIDER=
TAKO_STT_API_KEY=
TAKO_STT_MODEL=

